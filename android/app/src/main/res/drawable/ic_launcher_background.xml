<?xml version="1.0" encoding="utf-8"?>
<!-- Dawn sky behind the torii: gradient, rising sun, and the dark ground it
     rises from. Geometry matches public/favicon.svg (108dp adaptive grid). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#F9B06C"
                android:centerColor="#9E5A7D"
                android:centerY="0.45"
                android:endColor="#211E59" />
        </shape>
    </item>
    <item
        android:width="32dp"
        android:height="32dp"
        android:bottom="4dp"
        android:gravity="bottom|center_horizontal">
        <shape android:shape="oval">
            <solid android:color="#FFF1DC" />
        </shape>
    </item>
    <item android:top="88dp">
        <shape android:shape="rectangle">
            <solid android:color="#17152E" />
        </shape>
    </item>
</layer-list>
